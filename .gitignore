# Secrets / local env
.envrc
.env
.env.local
*.local

# App settings that may contain API keys
settings.json

# Private test fixtures (real-world KMLs)
test/fixtures/private/
# Generated perf fixtures (recreated by test helpers)
test/fixtures/big-*.kml

# Generated tile caches / scratch
tiles/
*.tmp

# Node / build
node_modules/
dist/
out/
release/
# build/ is electron-builder's buildResources dir — the app icon lives there and
# is source, not output. Ignore everything else that lands in it.
build/*
!build/make-icon.py
!build/icon.svg
!build/icon.png
!build/icon.ico
!build/icon.icns
.vite/
*.tsbuildinfo

# Electron packaging
*.dmg
*.AppImage
*.exe
*.nsis

# Logs
*.log
npm-debug.log*

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
PLAN.md
